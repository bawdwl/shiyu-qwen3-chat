* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf

*.onnx filter=lfs diff=lfs merge=lfs -text
android/app/src/main/assets/speech/kokoro/voices.bin filter=lfs diff=lfs merge=lfs -text
android/app/libs/*.aar filter=lfs diff=lfs merge=lfs -text
release/*.apk filter=lfs diff=lfs merge=lfs -text

# Vendored espeak/jieba data intentionally preserves upstream whitespace.
android/app/src/main/assets/speech/kokoro/dict/** -text -diff
android/app/src/main/assets/speech/kokoro/espeak-ng-data/** -text -diff

